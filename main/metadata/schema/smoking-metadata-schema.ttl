@prefix : <http://fairdatapoint.org/> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .

:Section1Group
  a sh:PropertyGroup ;
  rdfs:label "General Dataset Identification" ;
  sh:order 0 .

:Section3Group
  a sh:PropertyGroup ;
  rdfs:label "Usage & Legal Terms" ;
  sh:order 1 .

:Section2Group
  a sh:PropertyGroup ;
  rdfs:label "Provenance & Attribution" ;
  sh:order 2 .

:Shape
  a sh:NodeShape ;
  rdfs:label "Smoking Metadata Schema" ;
  sh:targetClass dcat:Dataset ;
  sh:property [
    sh:path dct:title ;
    sh:name "Title"@en ;
    sh:description "A human-readable title for the dataset"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dct:description ;
    sh:name "Description"@en ;
    sh:description "A free-text account of the dataset"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:TextAreaEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dct:publisher ;
    sh:name "Publisher"@en ;
    sh:description "The entity responsible for making the dataset available"@en ;
    sh:nodeKind sh:BlankNodeOrIRI ;
    sh:class foaf:Organization ;
    sh:node :PublisherShape ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 2 ;
    dash:editor dash:DetailsEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dct:issued ;
    sh:name "Issued" ;
    sh:description "Date of formal issuance"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:date ;
    sh:maxCount 1 ;
    sh:order 3 ;
    dash:editor dash:DatePickerEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dcat:keyword ;
    sh:name "Keyword(s)"@en ;
    sh:description "A keyword or tag describing the dataset"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:order 4 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section1Group
  ] ;
  sh:property [
    sh:path dct:license ;
    sh:name "License" ;
    sh:description "Legal permission to do, use, own, or access something"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:URIEditor ;
    sh:group :Section3Group
  ] ;
  sh:property [
    sh:path dct:accessRights ;
    sh:name "Access Rights"@en ;
    sh:description "Information about who can access the resource"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:in ( "public" "restricted" "private" ) ;
    sh:order 1 ;
    dash:editor dash:EnumSelectEditor ;
    sh:group :Section3Group
  ] ;
  sh:property [
    sh:path dct:creator ;
    sh:name "Author"@en ;
    sh:description "The entity responsible for creating the content of the published dataset"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:TextFieldEditor ;
    sh:group :Section2Group
  ] ;
  sh:property [
    sh:path dcat:landingPage ;
    sh:name "Source Dataset"@en ;
    sh:description "Link to the source of the original dataset"@en ;
    sh:nodeKind sh:IRI ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 1 ;
    dash:editor dash:URIEditor ;
    sh:group :Section2Group
  ] .

:PublisherShape
  a sh:NodeShape ;
  sh:targetClass foaf:Organization ;
  sh:property [
    sh:path foaf:name ;
    sh:name "Name"@en ;
    sh:nodeKind sh:Literal ;
    sh:datatype xsd:string ;
    sh:minCount 1 ;
    sh:maxCount 1 ;
    sh:order 0 ;
    dash:editor dash:TextFieldEditor
  ] .