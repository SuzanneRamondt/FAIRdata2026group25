@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct: <http://purl.org/dc/terms/> .

<https://w3id.org/FAIR-course-UT/2026/group25/metadata/record/distribution/smoking-health-dataset-csv> a dcat:Distribution ;
    dct:title "Smoking Health Dataset in CSV Format" ;
    dcat:distribution [
        a dcat:Distribution ;
        dct:format <http://publications.europa.eu/resource/authority/file-type/CSV> ;
        dcat:byteSize 167748 ;
        dcat:downloadURL <https://www.kaggle.com/api/v1/datasets/download/africahealthlab/smoking-health-dataset>
    ] .
